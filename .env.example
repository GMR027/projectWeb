DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=project
APP_URL=http://localhost:8000

# Zona horaria de la aplicación (por defecto America/Mazatlan)
APP_TIMEZONE=America/Mazatlan

# Correo de contacto de los botones de planes de la landing
CONTACT_EMAIL=

# Detrás de un proxy/Ingress: rangos (separados por coma) de los que se confía en X-Forwarded-For para conocer la IP real del visitante
# TRUSTED_PROXIES=10.1.0.0/16

# Copia de cada respaldo automático en otra ubicación (otro disco, NFS...), para no perderlo junto con los datos
# RESPALDO_COPIA_DIR=/mnt/respaldos-externos

# Antivirus ClamAV (clamd) para los archivos subidos. Con CLAMAV_REQUIRED=1 no se acepta ningún archivo si clamd no responde
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=1

# Bot de Telegram de la plataforma (Integraciones): token que da @BotFather. Con él ya funcionan avisos, avance y fotos desde el chat
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=      # opcional: se consulta solo
# Hora (0-23) a la que se registra el clima del día y se avisa del pronóstico de mañana (por defecto 18)
# CLIMA_AUTO_HORA=18
# Hora (0-23) a la que se manda el resumen de la obra por Telegram (por defecto 6)
# RESUMEN_HORA=6
# Peticiones por minuto que acepta /api/telegram/webhook por IP (por defecto 120; 0 = sin límite)
# TELEGRAM_RATE_MAX=120
