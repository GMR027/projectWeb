DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=project
APP_URL=http://localhost:8000

# Zona horaria de la aplicación (por defecto America/Mazatlan)
APP_TIMEZONE=America/Mazatlan

# Correo de contacto de los botones de planes de la landing
CONTACT_EMAIL=

# Detrás de un proxy/Ingress: rangos (separados por coma) de los que se confía en X-Forwarded-For para conocer la IP real del visitante
# TRUSTED_PROXIES=10.1.0.0/16

# Copia de cada respaldo automático en otra ubicación (otro disco, NFS...), para no perderlo junto con los datos
# RESPALDO_COPIA_DIR=/mnt/respaldos-externos
